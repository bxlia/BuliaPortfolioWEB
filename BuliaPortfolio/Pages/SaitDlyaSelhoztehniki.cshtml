@page
@{
    ViewData["Title"] = "Сайт для магазина сельхозтехники и запчастей: что важно | bulia";
    ViewData["Description"] = "Каталог техники и запчастей, подбор под хозяйство, заявка на наличие и цену. Что должно быть на сайте магазина сельхозтехники и сколько это стоит.";
    ViewData["CanonicalPath"] = "/SaitDlyaSelhoztehniki";

    var faq = new[]
    {
        ("Сколько стоит сайт магазина сельхозтехники?", "Одностраничный сайт с основными группами техники и заявкой — 15 000 ₽. Каталог с отдельными страницами по группам и моделям — от 30 000 ₽. Сумма фиксируется до начала работы."),
        ("Сколько времени занимает?", "Визитка — 5–7 рабочих дней, каталог — 10–14 дней. Срок зависит от того, есть ли готовый список моделей и характеристики."),
        ("Нужен ли интернет-магазин с оплатой картой?", "Обычно нет. Технику и дорогие запчасти не покупают одной кнопкой: сначала уточняют наличие, доставку и гарантию. Поэтому вместо корзины делается заявка на наличие и цену, а оплата идёт по счёту."),
        ("У нас уже есть прайс в Excel. Он подойдёт?", "Да, по нему можно собрать каталог. Если позиций много, часть выносится в отдельные страницы, чтобы по ним находили в поиске."),
        ("Кто делает фотографии техники?", "Фотографии и характеристики присылаете вы — я не придумываю данные о технике. Обрабатываю снимки, привожу к одному размеру и вписываю в макет.")
    };
}

@section Head {
    @{
        var faqData = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "FAQPage",
            ["mainEntity"] = faq.Select(item => new Dictionary<string, object>
            {
                ["@type"] = "Question",
                ["name"] = item.Item1,
                ["acceptedAnswer"] = new Dictionary<string, object>
                {
                    ["@type"] = "Answer",
                    ["text"] = item.Item2
                }
            }).ToArray()
        };
        var faqJson = System.Text.Json.JsonSerializer.Serialize(faqData, new System.Text.Json.JsonSerializerOptions
        {
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        });
    }
    @Html.Raw("<script type=\"application/ld+json\">" + faqJson + "</script>")
}

<article class="case-page">
    <span class="section-kicker">сельхозтехника</span>
    <h1>Сайт для магазина сельхозтехники: каталог, подбор и заявки</h1>

    <p class="case-lead">
        Покупатель техники и запчастей приходит с конкретной задачей: «нужен культиватор
        на 4 гектара» или «есть ли ремень на такую модель». Сайт выигрывает не картинками,
        а скоростью ответа на такой вопрос.
    </p>

    <div class="case-day">
        <span class="case-day-num">блок 1</span>
        <div>
            <h2>Первый экран: что продаёте и для каких хозяйств</h2>
            <p>
                Нужно сразу отделить «магазин для дачника» от «поставщика для фермерского
                хозяйства» — это разные клиенты и разная техника.
            </p>
            <ul>
                <li>что в наличии: техника, навесное, запчасти;</li>
                <li>для какого масштаба: от нескольких соток до промышленных полей;</li>
                <li>кнопка «Уточнить наличие».</li>
            </ul>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">блок 2</span>
        <div>
            <h2>Каталог с понятными группами</h2>
            <p>
                Покупатель редко знает модель наизусть. Он ищет по назначению:
                обработка почвы, посев, уборка, запчасти к конкретному агрегату.
            </p>
            <ul>
                <li>группы по назначению, внутри — модели;</li>
                <li>у модели: мощность, ширина захвата, агрегатирование;</li>
                <li>где нет цены — «цена по запросу» вместо пустого места.</li>
            </ul>
            <p>
                Отдельные страницы под популярные модели дают поисковый трафик:
                по ним ищут чаще, чем по названию магазина.
            </p>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">блок 3</span>
        <div>
            <h2>Подбор под хозяйство</h2>
            <p>
                Сильный блок для такой отрасли: короткая форма из двух-трёх вопросов —
                сколько гектаров, какая культура, что уже есть в хозяйстве.
                В ответ приходит 2–3 подходящих варианта.
            </p>
            <ul>
                <li>снимает страх «куплю не то»;</li>
                <li>работает как заявка без слов «оставьте телефон»;</li>
                <li>даёт продавцу понятный запрос, а не «интересует техника».</li>
            </ul>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">блок 4</span>
        <div>
            <h2>Наличие, доставка, гарантия</h2>
            <p>
                Технику за сотни тысяч не покупают вслепую. Три блока снимают
                основные вопросы до звонка.
            </p>
            <ul>
                <li>есть на складе или под заказ, срок поставки;</li>
                <li>доставка по регионам, самовывоз, разгрузка;</li>
                <li>гарантия и сервис: кто ремонтирует и где брать запчасти.</li>
            </ul>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">блок 5</span>
        <div>
            <h2>Мобильная версия для поля</h2>
            <p>
                Владелец хозяйства часто смотрит сайт с телефона, не в офисе.
                Значит каталог должен открываться быстро и без зума.
            </p>
            <ul>
                <li>таблицы характеристик, которые не разъезжаются;</li>
                <li>кнопка звонка и мессенджера на виду;</li>
                <li>сжатые фотографии — техника тяжёлая, страница не должна быть тяжёлой.</li>
            </ul>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">цена</span>
        <div>
            <h2>Сколько стоит и сколько ждать</h2>
            <ul>
                <li><strong>визитка</strong> с группами товаров — 15 000 ₽, 5–7 рабочих дней;</li>
                <li><strong>каталог</strong> с отдельными страницами моделей — от 30 000 ₽, 10–14 дней;</li>
                <li><strong>поддержка</strong> — 3 000 ₽ в месяц, по желанию.</li>
            </ul>
            <p>
                Делаю на чистом коде, без конструктора: страница грузится быстро
                даже на слабом интернете в поле.
            </p>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">вопросы</span>
        <div>
            <h2>Частые вопросы</h2>
            @foreach (var item in faq)
            {
                <h2 style="font-size:1.05rem;margin-bottom:.35rem">@item.Item1</h2>
                <p>@item.Item2</p>
            }
        </div>
    </div>

    <div class="case-total">
        <p>
            <strong>Пример структуры:</strong> демонстрационный сайт магазина сельхозтехники.
            Магазин вымышленный, это не заказ клиента.
        </p>
        <p style="margin-bottom:0">
            <a class="main-button" href="/#contact">Обсудить сайт</a>
            <a class="main-button secondary-button" asp-page="/Demo/Agro" style="margin-left:10px">Открыть пример</a>
        </p>
        <p style="margin-top:1rem">
            Другие отрасли: <a asp-page="/SaitDlyaAvtoservisa">сайт для автосервиса</a>,
            <a asp-page="/SaitDlyaHimii">сайт для поставщика химии</a>.
        </p>
    </div>
</article>
