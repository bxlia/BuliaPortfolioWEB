<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Портфолио bulia: разработка сайтов, программ на C# и баз данных SQL Server." />
    <meta name="theme-color" content="#0b1220" />
    <title>@ViewData["Title"] - BuliaPortfolio</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BuliaPortfolio.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Перейти к содержимому</a>

    <header class="site-header">
        <nav class="navbar navbar-expand-md">
            <div class="container site-header-inner">
                <a class="navbar-brand" asp-area="" asp-page="/Index">bulia<span class="brand-dot">.</span></a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#siteNav"
                        aria-controls="siteNav"
                        aria-expanded="false"
                        aria-label="Меню">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="siteNav">
                    <ul class="navbar-nav site-nav">
                        <li class="nav-item"><a class="nav-link" href="/#about">Обо мне</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#skills">Навыки</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#projects">Проекты</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#services">Услуги</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#contact">Контакты</a></li>
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main id="main" role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container site-footer-inner">
            <p class="site-footer-text">© 2026 bulia. C# / C++ / Web-разработка.</p>
            <p class="site-footer-links">
                <a href="https://github.com/bxlia" target="_blank" rel="noopener noreferrer">GitHub</a>
                <a href="https://www.fl.ru/users/bxlia82/portfolio/" target="_blank" rel="noopener noreferrer">FL.ru</a>
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
