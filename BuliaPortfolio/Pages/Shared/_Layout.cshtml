<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @{
        var pageTitle = ViewData["Title"] as string ?? "Сайты для бизнеса";
        var pageDescription = ViewData["Description"] as string
            ?? "Портфолио bulia: сайты-визитки, лендинги и каталоги на чистом коде. Примеры, цены и сроки.";
        var robots = ViewData["Robots"] as string ?? "index, follow";
        var baseUrl = $"{ViewContext.HttpContext.Request.Scheme}://{ViewContext.HttpContext.Request.Host}";
        var canonicalPath = ViewData["CanonicalPath"] as string ?? ViewContext.HttpContext.Request.Path.Value ?? "/";
        var canonicalUrl = baseUrl + canonicalPath;
        var ogImageUrl = baseUrl + "/images/og-preview.jpg";
    }
    <meta name="description" content="@pageDescription" />
    <meta name="robots" content="@robots" />
    <link rel="canonical" href="@canonicalUrl" />
    <meta name="theme-color" content="#0b1220" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="bulia" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@ogImageUrl" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="bulia — сайты для бизнеса" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@pageDescription" />
    <meta name="twitter:image" content="@ogImageUrl" />
    <link rel="icon" href="~/images/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/images/bulia-logo.png" />
    <script>document.documentElement.classList.add("js");</script>
    <title>@pageTitle</title>
    @await RenderSectionAsync("Head", required: false)
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/offer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BuliaPortfolio.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="scroll-progress" aria-hidden="true"></div>

    <a class="skip-link" href="#main">Перейти к содержимому</a>

    <header class="site-header">
        <nav class="navbar navbar-expand-md">
            <div class="container site-header-inner">
                <a class="navbar-brand" asp-area="" asp-page="/Index">bulia<span class="brand-dot">.</span></a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#siteNav"
                        aria-controls="siteNav"
                        aria-expanded="false"
                        aria-label="Меню">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="siteNav">
                    <ul class="navbar-nav site-nav">
                        <li class="nav-item"><a class="nav-link" href="/#about">Обо мне</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#skills">Навыки</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#projects">Проекты</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#services">Услуги</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#prices">Цены</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#demos">Демо</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Case">Кейс</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#process">Как я работаю</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#contact">Контакты</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main id="main" role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container site-footer-inner">
            <p class="site-footer-text">© 2026 bulia. C# / C++ / Web-разработка.</p>
            <p class="site-footer-links">
                <a href="https://github.com/bxlia" target="_blank" rel="noopener noreferrer">GitHub</a>
                <a href="https://www.fl.ru/users/bxlia82/portfolio/" target="_blank" rel="noopener noreferrer">FL.ru</a>
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/counters.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
