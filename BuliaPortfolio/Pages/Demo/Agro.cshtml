@page
@{
    Layout = null;
    ViewData["Title"] = "Демо: сельхозтехника";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta name="description" content="Демонстрационный сайт магазина сельхозтехники: техника, запчасти, подбор под хозяйство." />
    <title>Сельхозтехника и запчасти — демо-пример сайта</title>
    <script>document.documentElement.classList.add("d-js");</script>
    <link rel="stylesheet" href="~/css/demo.css" asp-append-version="true" />
</head>
<body class="d-body agro">
    <div class="d-demo-bar">
        Демонстрационный сайт. Сделан как пример — это не заказ клиента.
        <a asp-page="/Index">← вернуться в портфолио</a>
    </div>

    @* ==================== ШАПКА ==================== *@
    <header class="d-header">
        <div class="d-wrap d-header-inner">
            <a class="d-logo" href="#top">
                <span class="d-logo-mark">А</span>
                АгроТех<span>.</span>
            </a>

            <nav class="d-nav" aria-label="Разделы сайта">
                <a href="#catalog">Техника</a>
                <a href="#parts">Запчасти</a>
                <a href="#how">Подбор</a>
                <a href="#consult">Консультация</a>
            </nav>

            <a class="d-btn d-btn-primary" href="#consult">Подобрать технику</a>
        </div>
    </header>

    @* ==================== ПЕРВЫЙ ЭКРАН ==================== *@
    <section class="d-hero" id="top">
        <div class="d-wrap d-hero-grid">
            <div>
                <span class="d-kicker d-fade d-fade-1">техника и запчасти · доставка по России</span>

                <h1 class="d-h1 d-fade d-fade-2">Сельхозтехника, запчасти и ремонт</h1>

                <p class="d-lead d-fade d-fade-3">
                    Подбираем технику под хозяйство: от мотоблока до трактора.
                    Запчасти со склада, помощь с обкаткой и первым обслуживанием.
                </p>

                <div class="d-actions d-fade d-fade-4">
                    <a class="d-btn d-btn-primary d-btn-arrow" href="#consult">Подобрать технику</a>
                    <a class="d-btn d-btn-ghost" href="#catalog">Смотреть каталог</a>
                </div>

                <ul class="d-hero-points d-fade d-fade-5">
                    <li>
                        <strong><span data-count="140">140</span>+</strong>
                        <span>моделей техники</span>
                    </li>
                    <li>
                        <strong><span data-count="2">2</span> дня</strong>
                        <span>доставка по региону</span>
                    </li>
                    <li>
                        <strong><span data-count="12">12</span> мес.</strong>
                        <span>гарантия на технику</span>
                    </li>
                </ul>
            </div>

            <div class="d-hero-media d-fade d-fade-3">
                <img src="~/images/demo/agro-hero.jpg" alt="Трактор обрабатывает поле" width="1200" height="901" />
                <div class="d-float-card">
                    <span class="d-float-dot" aria-hidden="true"></span>
                    <span>
                        <b>Подбор за один день</b>
                        <small>по площади и задачам хозяйства</small>
                    </span>
                </div>
            </div>
        </div>
    </section>

    @* ==================== БЕГУЩАЯ СТРОКА ==================== *@
    <div class="d-ticker" aria-hidden="true">
        <div class="d-ticker-track">
            <span>мотоблоки</span>
            <span>мини-тракторы</span>
            <span>прицепы</span>
            <span>косилки</span>
            <span>гидравлика</span>
            <span>шины и камеры</span>
            <span>мотоблоки</span>
            <span>мини-тракторы</span>
            <span>прицепы</span>
            <span>косилки</span>
            <span>гидравлика</span>
            <span>шины и камеры</span>
        </div>
    </div>

    @* ==================== ТЕХНИКА ==================== *@
    <section class="d-section" id="catalog">
        <div class="d-wrap">
            <h2 class="d-h2 d-reveal">Техника</h2>
            <p class="d-sub d-reveal" style="--d-delay: .05s">
                Цены без доставки. Наличие уточняйте — склад обновляется каждую неделю.
            </p>

            <div class="d-grid">
                <article class="d-card d-reveal">
                    <div class="d-card-icon" aria-hidden="true">▤</div>
                    <h3>Мотоблоки</h3>
                    <p>Для участка до 1 га. Навесное оборудование: плуг, фреза, окучник.</p>
                    <span class="d-price">от 38 000 ₽</span>
                </article>

                <article class="d-card d-reveal" style="--d-delay: .08s">
                    <div class="d-card-icon" aria-hidden="true">▣</div>
                    <h3>Мини-тракторы</h3>
                    <p>Для хозяйства 5–20 га. С кабиной и без, с фронтальным погрузчиком.</p>
                    <span class="d-price">от 420 000 ₽</span>
                </article>

                <article class="d-card d-reveal" style="--d-delay: .16s">
                    <div class="d-card-icon" aria-hidden="true">▥</div>
                    <h3>Прицепы и навесное</h3>
                    <p>Прицепы, косилки, грабли, плуги. Подходим под популярные модели.</p>
                    <span class="d-price">от 52 000 ₽</span>
                </article>
            </div>
        </div>
    </section>

    @* ==================== ЗАПЧАСТИ ==================== *@
    <section class="d-section soft" id="parts">
        <div class="d-wrap">
            <h2 class="d-h2 d-reveal">Запчасти</h2>
            <p class="d-sub d-reveal" style="--d-delay: .05s">
                Скажите модель — проверим наличие и цену в течение дня.
            </p>

            <div class="d-table-wrap d-reveal">
                <table class="d-table">
                    <thead>
                        <tr>
                            <th>Категория</th>
                            <th>Срок</th>
                            <th>Цена</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Фильтры и расходники</td>
                            <td>в наличии</td>
                            <td>от 450 ₽</td>
                        </tr>
                        <tr>
                            <td>Ремни и цепи</td>
                            <td>в наличии</td>
                            <td>от 900 ₽</td>
                        </tr>
                        <tr>
                            <td>Гидравлика</td>
                            <td>1–3 дня</td>
                            <td>от 2 400 ₽</td>
                        </tr>
                        <tr>
                            <td>Шины и камеры</td>
                            <td>1–3 дня</td>
                            <td>от 3 100 ₽</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    @* ==================== ПОДБОР ==================== *@
    <section class="d-section" id="how">
        <div class="d-wrap">
            <h2 class="d-h2 d-reveal">Как подбираем технику</h2>
            <p class="d-sub d-reveal" style="--d-delay: .05s">
                Без навязывания: показываем два-три варианта и говорим, чем они отличаются.
            </p>

            <ol class="d-steps">
                <li class="d-reveal">
                    <h3>Считаем задачу</h3>
                    <p>Сколько гектаров, какая почва, что нужно делать: пахать, косить, возить.</p>
                </li>
                <li class="d-reveal" style="--d-delay: .08s">
                    <h3>Предлагаем варианты</h3>
                    <p>Два-три варианта с ценами и честной разницей: где проще, где надёжнее.</p>
                </li>
                <li class="d-reveal" style="--d-delay: .16s">
                    <h3>Помогаем запустить</h3>
                    <p>Собираем, обкатываем, показываем обслуживание и выдаём документы.</p>
                </li>
            </ol>
        </div>
    </section>

    @* ==================== ФОТО ==================== *@
    <section class="d-section soft">
        <div class="d-wrap">
            <h2 class="d-h2 d-reveal">Техника в работе</h2>
            <p class="d-sub d-reveal" style="--d-delay: .05s">
                Фотографии для демо взяты из открытых источников. На рабочем сайте — фото клиента.
            </p>

            <div class="d-gallery">
                <figure class="d-reveal">
                    <img src="~/images/demo/agro-hero.jpg" alt="Трактор на вспашке поля" width="1200" height="901" loading="lazy" decoding="async" />
                    <figcaption>обработка поля</figcaption>
                </figure>
                <figure class="d-reveal" style="--d-delay: .1s">
                    <img src="~/images/demo/agro-sunset.jpg" alt="Поле на закате" width="1200" height="800" loading="lazy" decoding="async" />
                    <figcaption>сезонные работы</figcaption>
                </figure>
            </div>
        </div>
    </section>

    @* ==================== ЗАЯВКА ==================== *@
    <section class="d-cta" id="consult" style="--d-cta-image: url('/images/demo/agro-sunset.jpg')">
        <div class="d-wrap d-cta-inner">
            <div class="d-reveal">
                <h2 class="d-h2">Подобрать технику</h2>
                <p class="d-sub">
                    Расскажите, сколько гектаров и что нужно делать — предложим
                    два-три варианта с ценами.
                </p>

                <ul class="d-cta-list">
                    <li>Москва, ул. Центральная, 23, офис 208</li>
                    <li>Пн–Сб с 9:00 до 19:00</li>
                    <li>Консультация бесплатная</li>
                    <li>Доставка по России, самовывоз со склада</li>
                </ul>
            </div>

            <form class="d-form d-reveal" style="--d-delay: .1s" onsubmit="return false;">
                <label for="demo-name">Имя</label>
                <input id="demo-name" type="text" placeholder="Как к вам обращаться" />

                <label for="demo-phone">Телефон</label>
                <input id="demo-phone" type="tel" placeholder="+7 900 000-00-00" />

                <label for="demo-task">Что нужно</label>
                <textarea id="demo-task" rows="3" placeholder="Например: мотоблок для 40 соток"></textarea>

                <button class="d-btn d-btn-primary" type="submit">Отправить</button>
                <p class="d-form-note">
                    Это демо-форма. На настоящем сайте заявка приходит на почту и в мессенджер.
                </p>
            </form>
        </div>
    </section>

    <footer class="d-footer">
        <div class="d-wrap d-footer-inner">
            <span>АгроТех — демонстрационный сайт, сделан как пример работы.</span>
            <a asp-page="/Index">Вернуться в портфолио</a>
        </div>
    </footer>

    <script src="~/js/demo.js" asp-append-version="true"></script>
</body>
</html>
