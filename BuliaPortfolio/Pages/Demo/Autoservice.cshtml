@page
@{
    Layout = null;
    ViewData["Title"] = "Демо: автосервис";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta name="description" content="Демонстрационный сайт автосервиса: услуги, цены, запись на ремонт." />
    <title>Автосервис и шиномонтаж — демо-пример сайта</title>
    <script>document.documentElement.classList.add("d-js");</script>
    <link rel="stylesheet" href="~/css/demo.css" asp-append-version="true" />
</head>
<body class="d-body auto">
    <div class="d-demo-bar">
        Демонстрационный сайт. Сделан как пример — это не заказ клиента.
        <a asp-page="/Index">← вернуться в портфолио</a>
    </div>

    @* ==================== ШАПКА ==================== *@
    <header class="d-header">
        <div class="d-wrap d-header-inner">
            <a class="d-logo" href="#top">
                <span class="d-logo-mark">М</span>
                МоторСервис<span>.</span>
            </a>

            <nav class="d-nav" aria-label="Разделы сайта">
                <a href="#services">Услуги</a>
                <a href="#how">Как записаться</a>
                <a href="#works">Фото</a>
                <a href="#booking">Контакты</a>
            </nav>

            <a class="d-btn d-btn-primary" href="#booking">Записаться</a>
        </div>
    </header>

    @* ==================== ПЕРВЫЙ ЭКРАН ==================== *@
    <section class="d-hero" id="top">
        <div class="d-wrap d-hero-grid">
            <div>
                <span class="d-kicker d-fade d-fade-1">ремонт и шиномонтаж · ежедневно с 9:00</span>

                <h1 class="d-h1 d-fade d-fade-2">Ремонт авто и шиномонтаж за один день</h1>

                <p class="d-lead d-fade d-fade-3">
                    Диагностика, замена масла, тормоза, подвеска, сезонная смена шин.
                    Записываетесь на удобное время — машину забираете в тот же день.
                </p>

                <div class="d-actions d-fade d-fade-4">
                    <a class="d-btn d-btn-primary d-btn-arrow" href="#booking">Записаться на ремонт</a>
                    <a class="d-btn d-btn-ghost" href="#services">Смотреть цены</a>
                </div>

                <ul class="d-hero-points d-fade d-fade-5">
                    <li>
                        <strong><span data-count="11" data-suffix=" лет">11 лет</span></strong>
                        <span>работаем с 2014 года</span>
                    </li>
                    <li>
                        <strong><span data-count="4">4</span> поста</strong>
                        <span>без очереди на улице</span>
                    </li>
                    <li>
                        <strong><span data-count="6">6</span> мес.</strong>
                        <span>гарантия на работы</span>
                    </li>
                </ul>
            </div>

            <div class="d-hero-media d-fade d-fade-3">
                <img src="~/images/demo/auto-hero.jpg" alt="Механик осматривает подвеску автомобиля" width="800" height="533" />
                <div class="d-float-card">
                    <span class="d-float-dot" aria-hidden="true"></span>
                    <span>
                        <b>3 свободных окна</b>
                        <small>на сегодня, после 15:00</small>
                    </span>
                </div>
            </div>
        </div>
    </section>

    @* ==================== БЕГУЩАЯ СТРОКА ==================== *@
    <div class="d-ticker" aria-hidden="true">
        <div class="d-ticker-track">
            <span>замена масла</span>
            <span>компьютерная диагностика</span>
            <span>тормозные колодки</span>
            <span>ремонт подвески</span>
            <span>шиномонтаж</span>
            <span>развал-схождение</span>
            <span>замена масла</span>
            <span>компьютерная диагностика</span>
            <span>тормозные колодки</span>
            <span>ремонт подвески</span>
            <span>шиномонтаж</span>
            <span>развал-схождение</span>
        </div>
    </div>

    @* ==================== УСЛУГИ ==================== *@
    <section class="d-section" id="services">
        <div class="d-wrap">
            <h2 class="d-h2 d-reveal">Услуги и цены</h2>
            <p class="d-sub d-reveal" style="--d-delay: .05s">
                Цены за работу. Запчасти — по согласованию, можно привезти свои.
            </p>

            <div class="d-grid">
                <article class="d-card d-reveal">
                    <div class="d-card-icon" aria-hidden="true">₽</div>
                    <h3>Замена масла и фильтров</h3>
                    <p>Подбираем масло под двигатель, меняем фильтр. Занимает около 40 минут.</p>
                    <span class="d-price">от 800 ₽</span>
                </article>

                <article class="d-card d-reveal" style="--d-delay: .08s">
                    <div class="d-card-icon" aria-hidden="true">⌁</div>
                    <h3>Компьютерная диагностика</h3>
                    <p>Считываем ошибки, объясняем причину простыми словами и что будет, если подождать.</p>
                    <span class="d-price">1 000 ₽</span>
                </article>

                <article class="d-card d-reveal" style="--d-delay: .16s">
                    <div class="d-card-icon" aria-hidden="true">◎</div>
                    <h3>Тормозные колодки</h3>
                    <p>Показываем износ на старых колодках. Меняем комплектом на ось.</p>
                    <span class="d-price">от 1 500 ₽</span>
                </article>

                <article class="d-card d-reveal">
                    <div class="d-card-icon" aria-hidden="true">≡</div>
                    <h3>Ремонт подвески</h3>
                    <p>Стойки, рычаги, шаровые. Начинаем с диагностики, чтобы не менять лишнего.</p>
                    <span class="d-price">от 2 500 ₽</span>
                </article>

                <article class="d-card d-reveal" style="--d-delay: .08s">
                    <div class="d-card-icon" aria-hidden="true">◍</div>
                    <h3>Шиномонтаж</h3>
                    <p>Комплект колёс с балансировкой. Хранение сезонных шин — 1 500 ₽ за сезон.</p>
                    <span class="d-price">2 200 ₽ <small>/ комплект</small></span>
                </article>

                <article class="d-card d-reveal" style="--d-delay: .16s">
                    <div class="d-card-icon" aria-hidden="true">↗</div>
                    <h3>Развал-схождение</h3>
                    <p>Стенд 3D. Делаем после ремонта подвески и при неравномерном износе шин.</p>
                    <span class="d-price">1 800 ₽</span>
                </article>
            </div>
        </div>
    </section>

    @* ==================== КАК ЗАПИСАТЬСЯ ==================== *@
    <section class="d-section soft" id="how">
        <div class="d-wrap">
            <h2 class="d-h2 d-reveal">Как проходит запись</h2>
            <p class="d-sub d-reveal" style="--d-delay: .05s">
                Три шага. Ничего не нужно выяснять по телефону и ждать ответа.
            </p>

            <ol class="d-steps">
                <li class="d-reveal">
                    <h3>Оставляете заявку</h3>
                    <p>Марка машины и что нужно. Хватит одной строки, например «Kia Rio, замена масла».</p>
                </li>
                <li class="d-reveal" style="--d-delay: .08s">
                    <h3>Согласуем время и цену</h3>
                    <p>Перезваниваем в течение 15 минут в рабочее время и называем сумму до ремонта.</p>
                </li>
                <li class="d-reveal" style="--d-delay: .16s">
                    <h3>Приезжаете и забираете</h3>
                    <p>Работаем при вас. Если нашли что-то ещё — сначала показываем и спрашиваем.</p>
                </li>
            </ol>
        </div>
    </section>

    @* ==================== ФОТО ==================== *@
    <section class="d-section" id="works">
        <div class="d-wrap">
            <h2 class="d-h2 d-reveal">Как это выглядит</h2>
            <p class="d-sub d-reveal" style="--d-delay: .05s">
                Чистый бокс, инструмент под рукой. На рабочем сайте здесь
                фотографии вашего сервиса, а не стоковые.
            </p>

            <div class="d-gallery">
                <figure class="d-reveal">
                    <img src="~/images/demo/auto-hero.jpg" alt="Работа механика под автомобилем" width="800" height="533" loading="lazy" decoding="async" />
                    <figcaption>ремонт подвески</figcaption>
                </figure>
                <figure class="d-reveal" style="--d-delay: .1s">
                    <img src="~/images/demo/auto-wheel-o.jpg" alt="Колесо автомобиля после шиномонтажа" width="800" height="600" loading="lazy" decoding="async" />
                    <figcaption>шиномонтаж</figcaption>
                </figure>
            </div>
        </div>
    </section>

    @* ==================== ЗАЯВКА ==================== *@
    <section class="d-cta" id="booking" style="--d-cta-image: url('/images/demo/auto-hero.jpg')">
        <div class="d-wrap d-cta-inner">
            <div class="d-reveal">
                <h2 class="d-h2">Записаться на ремонт</h2>
                <p class="d-sub">
                    Оставьте номер — перезвоним в течение 15 минут, скажем цену
                    и подберём удобное время.
                </p>

                <ul class="d-cta-list">
                    <li>Москва, ул. Примерная, 14</li>
                    <li>Пн–Сб с 9:00 до 20:00, Вс — по записи</li>
                    <li>Есть парковка и зона ожидания с кофе</li>
                    <li>Можно привезти свои запчасти</li>
                </ul>
            </div>

            <form class="d-form d-reveal" style="--d-delay: .1s" onsubmit="return false;">
                <label for="demo-name">Имя</label>
                <input id="demo-name" type="text" placeholder="Как к вам обращаться" />

                <label for="demo-phone">Телефон</label>
                <input id="demo-phone" type="tel" placeholder="+7 900 000-00-00" />

                <label for="demo-car">Марка и что нужно</label>
                <textarea id="demo-car" rows="3" placeholder="Например: Kia Rio, замена масла"></textarea>

                <button class="d-btn d-btn-primary" type="submit">Записаться</button>
                <p class="d-form-note">
                    Это демо-форма. На настоящем сайте заявка сразу приходит владельцу
                    в мессенджер и на почту.
                </p>
            </form>
        </div>
    </section>

    <footer class="d-footer">
        <div class="d-wrap d-footer-inner">
            <span>МоторСервис — демонстрационный сайт, сделан как пример работы.</span>
            <a asp-page="/Index">Вернуться в портфолио</a>
        </div>
    </footer>

    <script src="~/js/demo.js" asp-append-version="true"></script>
</body>
</html>
