@page "/Landing"
@model LandingModel

@{
    ViewData["Title"] = "Пример лендинга для бизнеса";
}

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
}

@* ==================== ПЕРВЫЙ ЭКРАН ==================== *@
<section class="lp-hero">
    <div class="lp-hero-inner">
        <p class="lp-badge">Пример лендинга для любого бизнеса</p>

        <h1>Сайт, который приводит заявки,<br />а не просто красиво выглядит</h1>

        <p class="lp-lead">
            Лендинг для услуг, товаров или мастерской. Показывает, как
            выглядит страница, которая решает главную задачу бизнеса —
            превращает посетителя в заявку.
        </p>

        <div class="lp-hero-actions">
            <a class="lp-btn" href="#lp-request">Заказать лендинг</a>
            <a class="lp-btn lp-btn-ghost" href="#lp-work">Посмотреть этапы</a>
        </div>

        <ul class="lp-numbers">
            <li><strong>3</strong><span>дней на лендинг</span></li>
            <li><strong>19 900 ₽</strong><span>стоимость сайта</span></li>
            <li><strong>100 %</strong><span>ваши файлы и доступы</span></li>
        </ul>
    </div>
</section>

@* ==================== ПРОБЛЕМА И РЕШЕНИЕ ==================== *@
<section class="lp-section">
    <h2 class="lp-title">Что не так с обычным сайтом</h2>

    <div class="lp-split">
        <div class="lp-card lp-card-bad">
            <h3>Так бывает без нормального сайта</h3>
            <ul>
                <li>Посетитель не понимает, чем вы занимаетесь, и уходит</li>
                <li>Заявки приходят в личные сообщения и теряются</li>
                <li>Невозможно посмотреть цены и примеры работ</li>
                <li>На телефоне всё разъезжается</li>
            </ul>
        </div>

        <div class="lp-card lp-card-good">
            <h3>Так становится, когда сайт сделан для продаж</h3>
            <ul>
                <li>С первого экрана ясно, что вы предлагаете</li>
                <li>Заявка уходит в форму и сразу попадает к вам</li>
                <li>Цены и гарантии видны без переписки</li>
                <li>Одинаково работает на телефоне и компьютере</li>
            </ul>
        </div>
    </div>
</section>

@* ==================== УСЛУГИ ==================== *@
<section class="lp-section lp-section-soft">
    <h2 class="lp-title">Что можно заказать</h2>
    <p class="lp-subtitle">Набор блоков подходит бизнесу в любой сфере — просто меняются тексты, цены и фотографии.</p>

    <div class="lp-grid">
        @foreach (var service in Model.Services)
        {
            <article class="lp-tile">
                <h3>@service.Title</h3>
                <p>@service.Text</p>
                <span class="lp-tile-price">@service.Price</span>
            </article>
        }
    </div>
</section>

@* ==================== ЭТАПЫ РАБОТЫ ==================== *@
<section class="lp-section" id="lp-work">
    <h2 class="lp-title">Как проходит работа</h2>
    <p class="lp-subtitle">Понятный порядок, без сюрпризов и «сюрприз, это ещё пять тысяч».</p>

    <ol class="lp-steps">
        <li>
            <span class="lp-step-num">1</span>
            <h3>Обсуждаем задачу</h3>
            <p>Вы рассказываете, чем занимаетесь и кто ваш клиент. Я задаю вопросы и предлагаю структуру.</p>
        </li>
        <li>
            <span class="lp-step-num">2</span>
            <h3>Согласуем тексты и цену</h3>
            <p>Фиксируем объём, срок и стоимость. Перед началом вы точно понимаете, что получите.</p>
        </li>
        <li>
            <span class="lp-step-num">3</span>
            <h3>Рисую и собираю страницу</h3>
            <p>Показываю, как будет выглядеть сайт, до того как он полностью готов. Вы вносите правки на каждом шаге.</p>
        </li>
        <li>
            <span class="lp-step-num">4</span>
            <h3>Запускаю и передаю</h3>
            <p>Публикую сайт, проверяю на телефоне, отдаю файлы и доступы. Две недели правок бесплатно.</p>
        </li>
    </ol>
</section>

@* ==================== ЦЕНЫ ==================== *@
<section class="lp-section lp-section-soft">
    <h2 class="lp-title">Сколько стоит</h2>
    <p class="lp-subtitle">Три варианта. Цена окончательная — не растёт в процессе.</p>

    <div class="lp-prices">
        @foreach (var price in Model.Prices)
        {
            var isMiddle = price.Name == "Оптимальный";

            <article class="lp-price @(isMiddle ? "lp-price-best" : "")">
                @if (isMiddle)
                {
                    <span class="lp-price-flag">Чаще всего выбирают</span>
                }

                <h3>@price.Name</h3>
                <p class="lp-price-cost">@price.Cost</p>
                <p class="lp-price-desc">@price.Description</p>

                <ul class="lp-price-list">
                    @foreach (var item in price.Included)
                    {
                        <li>@item</li>
                    }
                </ul>

                <a class="lp-btn @(isMiddle ? "" : "lp-btn-ghost")" href="#lp-request">
                    Выбрать
                </a>
            </article>
        }
    </div>
</section>

@* ==================== КАЛЬКУЛЯТОР ЦЕНЫ ==================== *@
<section class="lp-section" id="lp-calc">
    <h2 class="lp-title">Калькулятор цены</h2>
    <p class="lp-subtitle">
        Отметьте, что нужно, — покажу предварительную цену. Это не квитанция:
        точную назову после обсуждения задачи.
    </p>

    <div class="calc">
        <div class="calc-main">
            <fieldset class="calc-block">
                <legend>Что нужно сделать</legend>

                @foreach (var service in Model.CalculatorServices)
                {
                    <label class="calc-choice">
                        <input type="radio" name="calc-service" value="@service.Key" checked="@(service.Key == "site")" />
                        <span class="calc-choice-text">
                            <span class="calc-choice-title">@service.Title</span>
                            <span class="calc-choice-price">от @service.Price.ToString("N0") ₽</span>
                        </span>
                    </label>
                }
            </fieldset>

            <fieldset class="calc-block" data-only="site fix">
                <legend>Объём страниц</legend>

                @foreach (var volume in Model.CalculatorVolumes)
                {
                    <label class="calc-choice">
                        <input type="radio" name="calc-volume" value="@volume.Key" checked="@(volume.Key == "few")" data-price="@volume.Price" />
                        <span class="calc-choice-text">
                            <span class="calc-choice-title">@volume.Title</span>
                            @if (volume.Price > 0)
                            {
                                <span class="calc-choice-price">+@volume.Price.ToString("N0") ₽</span>
                            }
                        </span>
                    </label>
                }
            </fieldset>

            <fieldset class="calc-block">
                <legend>Что ещё нужно</legend>

                <label class="calc-choice">
                    <input type="checkbox" name="calc-db" data-price="@Model.DatabasePrice" />
                    <span class="calc-choice-text">
                        <span class="calc-choice-title">База данных и отчёты</span>
                        <span class="calc-choice-price">+@Model.DatabasePrice.ToString("N0") ₽</span>
                    </span>
                </label>

                <label class="calc-choice">
                    <input type="checkbox" name="calc-admin" data-price="@Model.AdminPrice" />
                    <span class="calc-choice-text">
                        <span class="calc-choice-title">Панель, где видны заявки</span>
                        <span class="calc-choice-price">+@Model.AdminPrice.ToString("N0") ₽</span>
                    </span>
                </label>

                <label class="calc-choice">
                    <input type="checkbox" name="calc-urgent" data-percent="@Model.UrgentPercent" />
                    <span class="calc-choice-text">
                        <span class="calc-choice-title">Нужно срочно</span>
                        <span class="calc-choice-price">+@Model.UrgentPercent%</span>
                    </span>
                </label>
            </fieldset>
        </div>

        <aside class="calc-result">
            <p class="calc-result-label">Предварительно выходит</p>
            <p class="calc-result-price" data-calc-price>18 000 ₽</p>

            <p class="calc-result-note">
                Цена может измениться, если задача окажется сложнее.
                Назову точную после короткого разговора.
            </p>

            <a class="lp-btn calc-result-btn" asp-page="/Index" asp-fragment="contact">
                Оставить заявку
            </a>

            <p class="calc-result-hint">
                Работаю по предоплате 50%, две недели правок бесплатно.
                Не нравится риск — оформляем через фриланс-биржу.
            </p>
        </aside>
    </div>
</section>

@* ==================== ОТЗЫВЫ ==================== *@
<section class="lp-section">
    <h2 class="lp-title">Отзывы</h2>
    <p class="lp-subtitle lp-note">На этой демонстрационной странице отзывы вымышленные. На рабочем сайте сюда ставят настоящие.</p>

    <div class="lp-reviews">
        <article class="lp-review">
            <p class="lp-review-text">
                Сделал лендинг за три дня. Заявки пошли уже на второй день,
                до этого мы их теряли в переписке.
            </p>
            <p class="lp-review-author">Ирина, студия маникюра</p>
        </article>
        <article class="lp-review">
            <p class="lp-review-text">
                Понравилось, что показал страницу до того, как всё закончил.
                Правки вносил без споров, срок не сдвинулся.
            </p>
            <p class="lp-review-author">Дмитрий, ремонт квартир</p>
        </article>
        <article class="lp-review">
            <p class="lp-review-text">
                Нужна была простая программа для заявок. Получил ровно то, что
                просил, плюс база и отчёт.
            </p>
            <p class="lp-review-author">Алексей, автосервис</p>
        </article>
    </div>
</section>

@* ==================== ВОПРОСЫ ==================== *@
<section class="lp-section lp-section-soft">
    <h2 class="lp-title">Частые вопросы</h2>

    <div class="lp-faq">
        @foreach (var item in Model.Questions)
        {
            <details class="lp-faq-item">
                <summary>@item.Question</summary>
                <p>@item.Answer</p>
            </details>
        }
    </div>
</section>

@* ==================== ФОРМА ЗАЯВКИ ==================== *@
<section class="lp-section lp-request" id="lp-request">
    <div class="lp-request-card">
        <div class="lp-request-text">
            <h2 class="lp-title">Расскажите о вашей задаче</h2>
            <p class="lp-subtitle">
                Отвечу в течение дня и подскажу, что можно сделать
                быстрее и дешевле.
            </p>
            <p class="lp-note">Заявка откроется в рабочей форме на главной странице.</p>
        </div>

        <div class="lp-cta">
            <a class="lp-btn" asp-page="/Index" asp-fragment="contact">Оставить заявку</a>
            <p class="lp-cta-note">Напишу, что можно сделать быстрее и дешевле, и назову точную цену.</p>
        </div>
    </div>
</section>

@* ==================== КОНТАКТЫ ==================== *@
<footer class="lp-footer">
    <div class="lp-footer-inner">
        <p>Пример лендинга. Сделан как демонстрация навыков вёрстки и сборки страниц.</p>
        <p class="lp-footer-links">
            <a asp-page="/Index">← Вернуться в портфолио</a>
        </p>
    </div>
</footer>

@section Scripts {
    <script>
        (function () {
            "use strict";

            var calculator = document.querySelector(".calc");

            if (!calculator) {
                return;
            }

            var priceNode = calculator.querySelector("[data-calc-price]");

            // Цена базовой услуи спрятана в data-price у первого переключателя.
            var serviceInputs = calculator.querySelectorAll("input[name='calc-service']");
            var volumeInputs = calculator.querySelectorAll("input[name='calc-volume']");
            var extraInputs = calculator.querySelectorAll("input[name='calc-db'], input[name='calc-admin']");
            var urgentInput = calculator.querySelector("input[name='calc-urgent']");

            var volumes = calculator.querySelectorAll("[data-only]");
            var serviceMap = {
                landing: @Model.CalculatorServices.First(x => x.Key == "landing").Price,
                site: @Model.CalculatorServices.First(x => x.Key == "site").Price,
                fix: @Model.CalculatorServices.First(x => x.Key == "fix").Price,
                program: @Model.CalculatorServices.First(x => x.Key == "program").Price,
                database: @Model.CalculatorServices.First(x => x.Key == "database").Price,
                bot: @Model.CalculatorServices.First(x => x.Key == "bot").Price
            };
            var minPrice = @Model.CalculatorMinPrice;
            var round = @Model.CalculatorRound;

            function formatMoney(value) {
                return value.toString().replace(/\B(?=(\d{3})+(?!\d))/g, " ") + " ₽";
            }

            function chosen(list) {
                for (var i = 0; i < list.length; i++) {
                    if (list[i].checked) {
                        return list[i];
                    }
                }
                return null;
            }

            // Показываем блок объёма только там, где он имеет смысл.
            function syncVisibility() {
                var current = chosen(serviceInputs);
                var key = current ? current.value : "";

                for (var i = 0; i < volumes.length; i++) {
                    var allowed = (volumes[i].getAttribute("data-only") || "").split(" ");

                    volumes[i].hidden = allowed.indexOf(key) === -1;
                }
            }

            function recalc() {
                syncVisibility();

                var current = chosen(serviceInputs);
                var total = current ? serviceMap[current.value] : 0;

                var visibleVolume = null;

                for (var i = 0; i < volumes.length; i++) {
                    if (!volumes[i].hidden) {
                        visibleVolume = chosen(volumes[i].querySelectorAll("input[name='calc-volume']"));
                    }
                }

                if (visibleVolume) {
                    total += parseInt(visibleVolume.getAttribute("data-price") || "0", 10);
                }

                for (var j = 0; j < extraInputs.length; j++) {
                    if (extraInputs[j].checked) {
                        total += parseInt(extraInputs[j].getAttribute("data-price") || "0", 10);
                    }
                }

                if (urgentInput && urgentInput.checked) {
                    total += Math.round(total * (parseInt(urgentInput.getAttribute("data-percent") || "0", 10) / 100));
                }

                if (total < minPrice) {
                    total = minPrice;
                }

                // округляем до сотен, чтобы цифра выглядела опрятно
                total = Math.round(total / round) * round;

                priceNode.textContent = formatMoney(total);
            }

            calculator.addEventListener("change", recalc);

            recalc();
        })();
    </script>
}
