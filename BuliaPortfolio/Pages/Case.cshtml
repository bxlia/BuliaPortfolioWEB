@page
@model CaseModel
@{
    ViewData["Title"] = "Кейс: как делается сайт за 5 дней — этапы, цена, ошибки | bulia";
    ViewData["Description"] = "Подробный разбор: от звонка до запуска за пять рабочих дней. Структура, тексты, вёрстка, форма с уведомлениями, что входит в 15 000 ₽ и что обычно ломается.";
    ViewData["CanonicalPath"] = "/Case";

    var faq = new[]
    {
        ("Почему пять дней, а не месяц?", "Потому что объём ограничен: одна страница, понятная услуга, готовые цены от заказчика. Месяц уходит, когда страниц много, каталог большой или заказчик не может собрать информацию. В этих случаях я сразу называю другой срок."),
        ("Что если мне не понравится макет?", "Показываю страницу в браузере, а не картинку. Правки по тексту и блокам — в тот же день, пока идёт работа. После сдачи месяц правок бесплатно: цены поменялись, добавили услугу — поправлю."),
        ("Можно ли потом самому менять текст?", "Да. Страница обычная, без конструктора. Присылаю файлы, объясняю, где какой блок. Если править самому не хочется — есть поддержка за 3 000 ₽ в месяц."),
        ("Что нужно, чтобы начать?", "Список услуг с ценами, фотографии, режим работы и адрес. Остальное — моя работа. Первый разговор 15–20 минут, дальше я не дёргаю по мелочам.")
    };
}

@section Head {
    @{
        var faqData = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "FAQPage",
            ["mainEntity"] = faq.Select(item => new Dictionary<string, object>
            {
                ["@type"] = "Question",
                ["name"] = item.Item1,
                ["acceptedAnswer"] = new Dictionary<string, object>
                {
                    ["@type"] = "Answer",
                    ["text"] = item.Item2
                }
            }).ToArray()
        };
        var faqJson = System.Text.Json.JsonSerializer.Serialize(faqData, new System.Text.Json.JsonSerializerOptions
        {
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        });
    }
    @Html.Raw("<script type=\"application/ld+json\">" + faqJson + "</script>")
}

@* Страница-кейс: как делается сайт по дням.
   Честно: это демонстрационный проект, а не заказ клиента. *@
<article class="case-page">
    <span class="section-kicker">кейс</span>
    <h1>Как делается сайт за 5 дней</h1>

    <p class="case-lead">
        Ниже — реальный порядок работы на примере демонстрационного сайта автосервиса.
        Пять рабочих дней, каждый день заканчивается тем, что можно открыть в браузере.
        Без «созвонимся на следующей неделе» и без сюрпризов в счёте.
    </p>

    <div class="case-day">
        <span class="case-day-num">день 1</span>
        <div>
            <h2>Задача и структура</h2>
            <p>
                Созваниваемся на 15–20 минут. Я спрашиваю: что за бизнес, кто клиент,
                как сейчас приходят заявки, что должно быть на сайте в первую очередь.
                Не «какой сайт вы хотите», а «что должно измениться после запуска».
            </p>
            <ul>
                <li>собираю список услуг и цены;</li>
                <li>решаю, сколько нужно страниц — обычно хватает одной;</li>
                <li>фиксирую, что входит в работу, и называю цену.</li>
            </ul>
            <p>
                Итог дня: короткое описание на полстраницы и согласованная цена.
                Дальше сумма не меняется. Если по ходу выясняется, что нужен каталог
                на двадцать позиций, — это отдельный разговор и другой срок, а не
                «доплатите потом».
            </p>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">день 2</span>
        <div>
            <h2>Тексты и структура экрана</h2>
            <p>
                Пишу тексты простым языком: что делаете, сколько стоит, как записаться.
                Без «динамично развивающейся компании» и «широкого спектра услуг» —
                эти фразы не отвечают ни на один вопрос клиента.
            </p>
            <ul>
                <li>заголовок, который понятен с первого взгляда;</li>
                <li>блок услуг с ценами — чтобы не звонили спрашивать цену;</li>
                <li>кнопка записи и телефон на видном месте.</li>
            </ul>
            <p>
                Отдельная работа — сокращать. Первый вариант текста всегда длиннее,
                чем нужно. На экране телефона видно, что два абзаца про историю
                компании просто сдвигают цены вниз, и человек до них не доходит.
            </p>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">день 3</span>
        <div>
            <h2>Вёрстка и мобильная версия</h2>
            <p>
                Собираю страницу на HTML и CSS без тяжёлых библиотек: быстрее грузится,
                меньше ломается. Сразу проверяю на телефоне — большинство клиентов
                приходят оттуда, часто со слабым интернетом.
            </p>
            <ul>
                <li>адаптация под экран от 320 пикселей;</li>
                <li>карта и кнопка мессенджера;</li>
                <li>проверка скорости загрузки и сжатие фотографий.</li>
            </ul>
            <p>
                Итог дня: ссылка, которую можно открыть и показать. Не картинка макета,
                а живая страница — её видно и на своём телефоне, и на телефоне коллеги.
            </p>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">день 4</span>
        <div>
            <h2>Форма заявки и уведомления</h2>
            <p>
                Подключаю форму: заявка сохраняется и сразу приходит владельцу
                в мессенджер. Это главная часть — сайт без заявок бесполезен,
                даже если он красивый.
            </p>
            <ul>
                <li>защита от спама без капчи;</li>
                <li>уведомление в MAX или Telegram;</li>
                <li>проверка: отправляю тестовую заявку и жду, что она дойдёт.</li>
            </ul>
            <p>
                Здесь чаще всего экономят и потом теряют деньги. Форма, которая пишет
                на почту, которую никто не читает, — это форма, которой нет.
                Поэтому проверяю доставку уведомления вручную, а не «должно работать».
            </p>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">день 5</span>
        <div>
            <h2>Запуск и передача</h2>
            <p>
                Публикую сайт, подключаю домен, показываю, как смотреть заявки.
                Всё оформляется на владельца — доступы остаются у него, а не у меня.
                Это принципиально: сайт не должен зависеть от подрядчика.
            </p>
            <ul>
                <li>проверка на телефоне и компьютере;</li>
                <li>передача файлов и доступов;</li>
                <li>месяц бесплатных правок после сдачи.</li>
            </ul>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">честно</span>
        <div>
            <h2>Что обычно ломается</h2>
            <p>
                Пять дней — это не про скорость ради скорости. Это про то, что
                в работе почти всегда что-то идёт не по плану. Вот что встречается чаще всего:
            </p>
            <ul>
                <li><strong>нет цен.</strong> «Цены индивидуально» — и половина посетителей уходит искать дальше. Вилка «от» лучше, чем ничего;</li>
                <li><strong>стоковые фото.</strong> Чужие люди в чужих комбинезонах вызывают недоверие. Три снимка на телефон лучше десяти красивых;</li>
                <li><strong>форма без уведомлений.</strong> Заявки падают в почту, которую не открывают. Проверять доставку нужно до сдачи;</li>
                <li><strong>сайт «на потом».</strong> Пока делается идеальная версия, заявки продолжают уходить конкурентам. Лучше простая страница сегодня, чем идеальная через три месяца.</li>
            </ul>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">цена</span>
        <div>
            <h2>Что входит в 15 000 ₽</h2>
            <p>
                Это стоимость одностраничного сайта. Каталог с отдельными страницами
                услуг — от 30 000 ₽, срок 10–14 дней. В цену входит вся работа,
                а не «настройка шаблона»:
            </p>
            <ul>
                <li>структура и тексты;</li>
                <li>вёрстка на чистом коде и адаптив;</li>
                <li>форма с уведомлениями в мессенджер;</li>
                <li>базовая SEO-разметка и карта сайта;</li>
                <li>запуск, домен, передача доступов;</li>
                <li>месяц правок бесплатно.</li>
            </ul>
            <p>
                Отдельно оплачиваются только домен и хостинг — напрямую провайдерам,
                примерно 200–1 000 ₽ в год и от 300 ₽ в месяц.
            </p>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">вопросы</span>
        <div>
            <h2>Частые вопросы</h2>
            @foreach (var item in faq)
            {
                <h2 style="font-size:1.05rem;margin-bottom:.35rem">@item.Item1</h2>
                <p>@item.Item2</p>
            }
        </div>
    </div>

    <div class="case-total">
        <p>
            <strong>Что получилось:</strong> одна страница, услуги и цены, карта, кнопка записи,
            заявки в мессенджер. Срок — 5 рабочих дней, цена — 15 000 ₽.
            Пример — демонстрационный сайт, не заказ клиента.
        </p>
        <p style="margin-bottom:0">
            <a class="main-button" href="/#contact">Хочу такой же</a>
            <a class="main-button secondary-button" asp-page="/Demo/Autoservice" style="margin-left:10px">Посмотреть пример</a>
        </p>
        <p style="margin-top:1rem">
            Разборы по отраслям: <a asp-page="/SaitDlyaAvtoservisa">автосервис</a>,
            <a asp-page="/SaitDlyaHimii">поставщик химии</a>,
            <a asp-page="/SaitDlyaSelhoztehniki">сельхозтехника</a>.
        </p>
    </div>
</article>
