@page
@{
    ViewData["Title"] = "Сайт для салона красоты: услуги, мастера и запись | bulia";
    ViewData["Description"] = "Что должно быть на сайте салона красоты или студии: услуги и цены, мастера, атмосфера, запись без звонка. Структура, сроки и стоимость.";
    ViewData["CanonicalPath"] = "/SaitDlyaKrasoty";

    var faq = new[]
    {
        ("Сколько стоит сайт салона красоты?", "Одностраничный сайт с услугами, ценами и записью — 15 000 ₽. Расширенный вариант с отдельными страницами услуг и мастеров — от 30 000 ₽. Сумма фиксируется до начала работы."),
        ("Сколько времени занимает?", "Визитка — 5–7 рабочих дней, расширенный сайт — 10–14 дней. Срок зависит от того, готовы ли фотографии работ и список услуг с ценами."),
        ("Нужна ли онлайн-запись?", "Да, если салон уже ведёт запись в DIKIDI, YCLIENTS или другой программе — ставлю кнопку на неё, чтобы не было двух разных расписаний. Если программы нет, делаю форму заявки: клиент оставляет имя и услугу, вы подтверждаете время."),
        ("Можно ли принимать оплату на сайте?", "Можно, но чаще это не нужно: услугу оплачивают в салоне. Онлайн-оплата усложняет возвраты и требует эквайринга. Если нужна предоплата за длинную процедуру — обсуждаем отдельно."),
        ("Кто делает фотографии?", "Фотографии работ и салона присылаете вы. Я не выдаю стоковые снимки за ваши работы: на сайтах красоты это сразу заметно и подрывает доверие. Обрабатываю снимки и привожу к одному размеру."),
        ("Нужен ли сайту интернет-магазин косметики?", "Обычно нет. Продажа шампуней и масок с доставкой — отдельная история с остатками и оплатой. Для салона важнее запись и доверие, а не корзина.")
    };
}

@section Head {
    @{
        var faqData = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "FAQPage",
            ["mainEntity"] = faq.Select(item => new Dictionary<string, object>
            {
                ["@type"] = "Question",
                ["name"] = item.Item1,
                ["acceptedAnswer"] = new Dictionary<string, object>
                {
                    ["@type"] = "Answer",
                    ["text"] = item.Item2
                }
            }).ToArray()
        };
        var faqJson = System.Text.Json.JsonSerializer.Serialize(faqData, new System.Text.Json.JsonSerializerOptions
        {
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        });
    }
    @Html.Raw("<script type=\"application/ld+json\">" + faqJson + "</script>")
}

<article class="case-page">
    <span class="section-kicker">салон красоты</span>
    <h1>Сайт для салона красоты: услуги, мастера и запись без звонка</h1>

    <p class="case-lead">
        Клиент выбирает салон не по слову «качество», а по конкретному мастеру,
        цене и свободному времени. Сайт должен показать это за несколько секунд
        и сразу дать возможность записаться.
    </p>

    <div class="case-day">
        <span class="case-day-num">блок 1</span>
        <div>
            <h2>Первый экран: что за салон и как записаться</h2>
            <p>
                Человек должен понять, подходит ли ему салон, не листая страницу.
                Поэтому на первом экране — направление, атмосфера и кнопка записи.
            </p>
            <ul>
                <li>что делаете: стрижки, окрашивание, уход, маникюр;</li>
                <li>часы работы и ближайший свободный слот;</li>
                <li>кнопка «Записаться» без звонка и лишних вопросов.</li>
            </ul>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">блок 2</span>
        <div>
            <h2>Услуги и цены без мелкого шрифта</h2>
            <p>
                Клиент не любит выяснять цену в переписке. Если цена зависит
                от длины волос или объёма работы, так и пишется: «от» и что входит.
            </p>
            <ul>
                <li>группы услуг: волосы, ногти, уход, визаж;</li>
                <li>цена «от», длительность и что входит в процедуру;</li>
                <li>отдельные страницы под популярные услуги — по ним ищут в поиске.</li>
            </ul>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">блок 3</span>
        <div>
            <h2>Мастера: имя, специализация, работы</h2>
            <p>
                В салон часто идут «к мастеру», а не в салон. Без имён и примеров
                работ страница теряет главный аргумент.
            </p>
            <ul>
                <li>фото и имя мастера, направление работы;</li>
                <li>3–6 реальных работ, а не стоковые картинки;</li>
                <li>у каждой карточки — запись именно к этому мастеру.</li>
            </ul>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">блок 4</span>
        <div>
            <h2>Атмосфера и доверие</h2>
            <p>
                Фотографии салона, отзывы и понятные правила снимают страх
                «приду, а там не так, как на картинке».
            </p>
            <ul>
                <li>2–3 фотографии зала и рабочего места;</li>
                <li>живые отзывы с именем и услугой — без выдуманных текстов;</li>
                <li>как добраться: карта, вход, парковка.</li>
            </ul>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">блок 5</span>
        <div>
            <h2>Запись: коротко и без двойного расписания</h2>
            <p>
                Если салон уже работает в DIKIDI или YCLIENTS, сайт ведёт
                в эту же запись. Отдельная форма нужна, только когда программы нет.
            </p>
            <ul>
                <li>минимум полей: имя, услуга, удобное время;</li>
                <li>подтверждение приходит в мессенджер или на телефон;</li>
                <li>заявка не теряется в личных сообщениях.</li>
            </ul>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">блок 6</span>
        <div>
            <h2>Мобильная версия и быстрая загрузка</h2>
            <p>
                Большая часть клиентов открывает сайт с телефона, часто по ссылке
                из карт или соцсетей. Страница должна открыться за пару секунд
                и не требовать зума.
            </p>
            <ul>
                <li>кнопка звонка и записи на виду;</li>
                <li>фотографии сжаты, без тяжёлых слайдеров;</li>
                <li>услуги читаются в одну колонку.</li>
            </ul>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">цена</span>
        <div>
            <h2>Сколько стоит и сколько ждать</h2>
            <ul>
                <li><strong>визитка</strong> с услугами, ценами и записью — 15 000 ₽, 5–7 рабочих дней;</li>
                <li><strong>расширенный сайт</strong> со страницами услуг и мастеров — от 30 000 ₽, 10–14 дней;</li>
                <li><strong>поддержка</strong> — 3 000 ₽ в месяц, по желанию.</li>
            </ul>
            <p>
                Делаю на чистом коде, без конструктора: страница быстро грузится
                и не ломается после обновлений чужой платформы.
            </p>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">вопросы</span>
        <div>
            <h2>Частые вопросы</h2>
            @foreach (var item in faq)
            {
                <h2 style="font-size:1.05rem;margin-bottom:.35rem">@item.Item1</h2>
                <p>@item.Item2</p>
            }
        </div>
    </div>

    <div class="case-total">
        <p>
            <strong>Пример структуры:</strong> демонстрационный сайт студии красоты.
            Студия вымышленная, это не заказ клиента.
        </p>
        <p style="margin-bottom:0">
            <a class="main-button" href="/#contact">Обсудить сайт</a>
            <a class="main-button secondary-button" asp-page="/Demo/Beauty" style="margin-left:10px">Открыть пример</a>
        </p>
        <p style="margin-top:1rem">
            Другие отрасли: <a asp-page="/SaitDlyaAvtoservisa">сайт для автосервиса</a>,
            <a asp-page="/SaitDlyaHimii">сайт для поставщика химии</a>,
            <a asp-page="/SaitDlyaSelhoztehniki">сайт для магазина сельхозтехники</a>.
        </p>
    </div>
</article>
