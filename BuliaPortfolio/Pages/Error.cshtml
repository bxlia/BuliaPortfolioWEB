@page
@model ErrorModel
@{
    ViewData["Title"] = Model.Title;
}

<section class="about">
    <h1>@Model.Title</h1>

    <p>@Model.Message</p>

    <a class="main-button" asp-page="/Index">На главную</a>

    @if (Model.ShowRequestId)
    {
        <p class="request-id">
            Код обращения: <code>@Model.RequestId</code>
        </p>
    }
</section>
