@page
@{
    ViewData["Title"] = "Сайт для автосервиса: что должно быть и сколько стоит | bulia";
    ViewData["Description"] = "Разбираю по блокам: услуги с ценами, запись на ремонт, карта, фото цеха. Сколько стоит сайт автосервиса, сроки и ошибки, из-за которых нет заявок.";
    ViewData["CanonicalPath"] = "/SaitDlyaAvtoservisa";

    var faq = new[]
    {
        ("Сколько стоит сайт автосервиса?", "Одностраничный сайт с услугами, ценами, картой и формой записи — 15 000 ₽. Если нужен каталог услуг с отдельными страницами — от 30 000 ₽. Сумма фиксируется до начала работы и не меняется."),
        ("Сколько времени займёт?", "Визитка — 5–7 рабочих дней, каталог — 10–14. Срок считается от момента, когда есть список услуг и цены: без них структуру не собрать."),
        ("У меня есть группа ВКонтакте. Зачем отдельный сайт?", "Группа хороша для тех, кто вас уже знает. Сайт приводит новых: он находится в поиске по запросам «ремонт стартера рядом», «развал-схождение цена». Плюс сайт не блокируют и он не зависит от чужой ленты."),
        ("Что нужно от меня?", "Список услуг с ценами, фотографии цеха или работ, режим работы и адрес. Тексты пишу сам, согласовываю с вами. Занимает у владельца около часа."),
        ("Домен и хостинг — это отдельно?", "Да, оплачиваются напрямую провайдерам и оформляются на вас. Домен — примерно 200–1 000 ₽ в год, хостинг для такого сайта — от 300 ₽ в месяц.")
    };
}

@section Head {
    @{
        var faqData = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "FAQPage",
            ["mainEntity"] = faq.Select(item => new Dictionary<string, object>
            {
                ["@type"] = "Question",
                ["name"] = item.Item1,
                ["acceptedAnswer"] = new Dictionary<string, object>
                {
                    ["@type"] = "Answer",
                    ["text"] = item.Item2
                }
            }).ToArray()
        };
        var faqJson = System.Text.Json.JsonSerializer.Serialize(faqData, new System.Text.Json.JsonSerializerOptions
        {
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        });
    }
    @Html.Raw("<script type=\"application/ld+json\">" + faqJson + "</script>")
}

<article class="case-page">
    <span class="section-kicker">автосервисам</span>
    <h1>Сайт для автосервиса: что должно быть и сколько стоит</h1>

    <p class="case-lead">
        Сайт автосервису нужен не «для солидности». Он нужен, чтобы человек с поломкой
        нашёл вас в поиске и записался, не звоня наугад по пяти номерам.
        Ниже — блоки, без которых страница не приносит записей, и честные цены.
    </p>

    <div class="case-day">
        <span class="case-day-num">блок 1</span>
        <div>
            <h2>Первый экран: что ремонтируете и где находитесь</h2>
            <p>
                Человек попадает на сайт и за две секунды решает, его это или нет.
                Значит на первом экране должно быть три вещи: что вы делаете,
                где находитесь и как записаться.
            </p>
            <ul>
                <li>заголовок по делу: «Ремонт ходовой и двигателя», а не «Мы лучшие»;</li>
                <li>район или ориентир — люди ищут сервис рядом с домом;</li>
                <li>кнопка записи и режим работы без прокрутки.</li>
            </ul>
            <p>
                Частая ошибка — большой баннер с чужой фотографией и логотипом,
                а суть спрятана ниже. Такой экран не читают.
            </p>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">блок 2</span>
        <div>
            <h2>Услуги с ценами</h2>
            <p>
                Самый важный блок. Если цен нет, человек уходит искать дальше —
                а если звонит, то только чтобы спросить цену, и это съедает время мастера.
            </p>
            <ul>
                <li>8–12 позиций, а не «все виды ремонта»;</li>
                <li>вилка «от 1 500 ₽» вместо точной суммы, если цена зависит от машины;</li>
                <li>сроки: «замена колодок — 40 минут».</li>
            </ul>
            <p>
                Отдельно вынесите сезонные услуги: шиномонтаж, подготовка к зиме.
                По ним идут запросы в конкретные месяцы.
            </p>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">блок 3</span>
        <div>
            <h2>Запись без звонка</h2>
            <p>
                Половина людей не звонит: неудобно, шумно, боятся навязывания.
                Форма снимает этот барьер — четыре поля, не больше.
            </p>
            <ul>
                <li>имя и телефон;</li>
                <li>марка машины и что случилось — «стучит справа на кочках»;</li>
                <li>удобное время или «перезвоните».</li>
            </ul>
            <p>
                Заявка должна приходить сразу в мессенджер, а не лежать в почте,
                которую никто не открывает. Иначе форма есть, а записей нет.
            </p>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">блок 4</span>
        <div>
            <h2>Карта, часы работы, как заехать</h2>
            <p>
                В автосервисах половина звонков — «как к вам заехать». Снимает вопрос
                карта и два предложения текстом: где поворот, есть ли парковка,
                куда заходить.
            </p>
            <ul>
                <li>встроенная карта, а не картинка;</li>
                <li>режим работы с обедом и выходными;</li>
                <li>фраза «заезд со двора, ворота №2» экономит звонки.</li>
            </ul>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">блок 5</span>
        <div>
            <h2>Доверие: фото цеха и мастеров</h2>
            <p>
                Люди боятся оставить машину незнакомцам. Снимает страх не текст,
                а фотографии: подъёмник, инструмент, лица.
            </p>
            <ul>
                <li>3–5 своих фото, снятых на телефон, — лучше стоковых картинок;</li>
                <li>короткие отзывы с именем и маркой машины;</li>
                <li>гарантия на работы — конкретный срок, а не «гарантируем качество».</li>
            </ul>
            <p>
                Стоковые фото мастеров в чужих комбинезонах видно сразу, и они работают
                против вас.
            </p>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">блок 6</span>
        <div>
            <h2>Мобильная версия и скорость</h2>
            <p>
                Большинство заходят с телефона, часто на улице и с плохой связью.
                Тяжёлая страница на 10 секунд загрузки теряет человека раньше,
                чем он увидит цены.
            </p>
            <ul>
                <li>кнопка «Позвонить» на всю ширину экрана;</li>
                <li>шрифт, который читается без увеличения;</li>
                <li>картинки сжаты, ничего не «прыгает» при загрузке.</li>
            </ul>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">цена</span>
        <div>
            <h2>Сколько это стоит и сколько ждать</h2>
            <p>
                Сайт делаю вручную на чистом коде, без конструкторов и подписок.
                Сайт ваш, доступы у вас, ежемесячная плата за конструктор не нужна.
            </p>
            <ul>
                <li><strong>визитка</strong> — 15 000 ₽, 5–7 рабочих дней;</li>
                <li><strong>каталог</strong> с отдельными страницами услуг — от 30 000 ₽, 10–14 дней;</li>
                <li><strong>поддержка</strong> — 3 000 ₽ в месяц, по желанию.</li>
            </ul>
            <p>
                В цену входит структура, тексты, вёрстка, адаптив, форма с уведомлениями
                и запуск. Месяц правок после сдачи — бесплатно.
            </p>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">вопросы</span>
        <div>
            <h2>Частые вопросы</h2>
            @foreach (var item in faq)
            {
                <h2 style="font-size:1.05rem;margin-bottom:.35rem">@item.Item1</h2>
                <p>@item.Item2</p>
            }
        </div>
    </div>

    <div class="case-total">
        <p>
            <strong>Посмотреть, как это выглядит:</strong> демонстрационный сайт автосервиса —
            другой, вымышленный сервис, не заказ клиента. Сделан как пример структуры.
        </p>
        <p style="margin-bottom:0">
            <a class="main-button" href="/#contact">Обсудить сайт</a>
            <a class="main-button secondary-button" asp-page="/Demo/Autoservice" style="margin-left:10px">Открыть пример</a>
        </p>
        <p style="margin-top:1rem">
            Другие отрасли: <a asp-page="/SaitDlyaHimii">сайт для поставщика химии</a>,
            <a asp-page="/SaitDlyaSelhoztehniki">сайт для магазина сельхозтехники</a>.
        </p>
    </div>
</article>
