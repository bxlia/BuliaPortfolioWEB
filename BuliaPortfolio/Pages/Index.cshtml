@page
@model IndexModel

@{
    ViewData["Title"] = "Портфолио bulia";
}

@* ==================== ГЛАВНЫЙ ЭКРАН ==================== *@
<section id="home" class="hero">
    <p class="hero-label">C# / C++ / Web-разработка</p>

    <h1>Привет, я bulia</h1>

    <p class="hero-text">
        Разрабатываю сайты, программы для Windows и приложения
        с базами данных.
    </p>

    <a class="main-button" href="#projects">
        Посмотреть проекты
    </a>
</section>

@* ==================== ОБО МНЕ ==================== *@
<section id="about" class="about">
    <h2>Обо мне</h2>

    <p>
        Я программист и ученик 11 класса. Работаю в Visual Studio 2022.
        Разрабатываю в сфере программирования более 3 лет.
        Изучаю C#, C++, HTML, CSS, JavaScript и SQL.
    </p>

    <p>
        Создаю понятные и полезные программы для бизнеса и частных клиентов.
    </p>
</section>

@* ==================== МОИ ПРОЕКТЫ ==================== *@
<section id="projects" class="projects">
    <h2>Мои проекты</h2>

    <div class="project-list">
        @foreach (var project in Model.Projects)
        {
            <article class="project-card">
                <h3>@project.Title</h3>

                <p>@project.ShortDescription</p>

                @if (!string.IsNullOrWhiteSpace(project.Technologies))
                {
                    <span>@project.Technologies</span>
                }

                @if (!string.IsNullOrWhiteSpace(project.ProjectUrl))
                {
                    <a class="main-button" href="@project.ProjectUrl" target="_blank">
                        Открыть проект
                    </a>
                }

                @if (!string.IsNullOrWhiteSpace(project.GitHubUrl))
                {
                    <a class="main-button secondary-button" href="@project.GitHubUrl" target="_blank">
                        GitHub проекта
                    </a>
                }
            </article>
        }
    </div>
</section>

@* ==================== УСЛУГИ ==================== *@
<section id="services" class="services">
    <h2>Чем я могу помочь</h2>

    <div class="service-list">
        <article class="service-card">
            <h3>Сайт или лендинг</h3>
            <p>
                Создам простую современную страницу для услуг,
                портфолио или небольшого бизнеса.
            </p>
        </article>

        <article class="service-card">
            <h3>Доработка сайта</h3>
            <p>
                Помогу исправить HTML, CSS и JavaScript,
                добавить блоки, форму или адаптацию под телефон.
            </p>
        </article>

        <article class="service-card">
            <h3>Программа на C#</h3>
            <p>
                Создам небольшую программу для Windows:
                работа с файлами, таблицами и настройками.
            </p>
        </article>
    </div>
</section>

@* ==================== КОНТАКТЫ И ФОРМА ЗАЯВКИ ==================== *@
<section id="contact" class="contact">
    <h2>Связаться со мной</h2>

    <p>
        Если вам нужна небольшая программа, сайт или база данных,
        напишите мне.
    </p>

    @* ==================== СООБЩЕНИЕ ОБ УСПЕХЕ ==================== *@
    @if (Model.IsRequestSent)
    {
        <p class="success-message">
            Спасибо! Заявка отправлена. Я свяжусь с вами.
        </p>
    }

    @* ==================== ФОРМА ЗАЯВКИ ==================== *@
    <form method="post" class="request-form">
        <label asp-for="ClientName">Ваше имя</label>
        <input asp-for="ClientName"
               placeholder="Например: Иван"
               required />

        <label asp-for="ClientContact">Как с вами связаться</label>
        <input asp-for="ClientContact"
               placeholder="Telegram, телефон или email"
               required />

        <label asp-for="ClientMessage">Что нужно сделать</label>
        <textarea asp-for="ClientMessage"
                  rows="5"
                  placeholder="Коротко опишите задачу"
                  required></textarea>

        <button class="main-button" type="submit">
            Отправить заявку
        </button>
    </form>

    @* ==================== ВНЕШНИЕ ССЫЛКИ ==================== *@
    <div class="contact-buttons">
        <a class="main-button" href="https://github.com/bxlia" target="_blank">
            GitHub
        </a>

        <a class="main-button secondary-button"
           href="https://www.fl.ru/users/bxlia82/portfolio/"
           target="_blank">
            Написать мне на FL.ru
        </a>
    </div>
</section>