@page
@model IndexModel
@using BuliaPortfolio.Models
@using BuliaPortfolio.Services

@{
    ViewData["Title"] = "Портфолио bulia";

    // Ссылки на мессенджер с готовым первым сообщением.
    var quizTgUrl = SiteInfo.TelegramUrl("Здравствуйте! Посчитал цену на сайте — подскажите точнее.");
    var contactTgUrl = SiteInfo.TelegramUrl("Здравствуйте! Пишу с сайта по поводу сайта.");

    // Технологии приходят одной строкой через запятую — разбиваем на список.
    var techTags = new Func<Project, List<string>>(project =>
        string.IsNullOrWhiteSpace(project.Technologies)
            ? []
            : project.Technologies
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToList());

    // Навыки группируем по категориям: Backend, Frontend, Database.
    var skillGroups = Model.Skills
        .GroupBy(skill => string.IsNullOrWhiteSpace(skill.Category) ? "Другое" : skill.Category)
        .ToList();

    var techCount = Model.Skills.Select(skill => skill.Name).Distinct().Count();
}

@* ==================== ГЛАВНЫЙ ЭКРАН ==================== *@
<section id="home" class="hero">
    <p class="hero-label reveal">доступен для заказов</p>

    <div class="hero-terminal reveal">
        <span class="prompt">$</span> whoami
        <div>bulia — C# / .NET / Web<span class="cursor" aria-hidden="true"></span></div>
    </div>

    <h1 class="reveal reveal-d1">Делаю сайты и программы, которые работают</h1>

    <p class="hero-text reveal reveal-d2">
        Сайты с формой заявок и панелью администратора, программы для Windows
        и базы данных SQL Server. Показываю страницу до того, как она готова,
        чтобы правки вносились на каждом шаге.
    </p>

    <div class="hero-actions reveal reveal-d3">
        <a class="main-button" href="#prices">Цены и сроки</a>
        <a class="main-button secondary-button" href="#demos">Примеры</a>
        <a class="main-button secondary-button" href="#quiz">Рассчитать цену</a>
        <a class="main-button secondary-button" href="#contact">Написать</a>
    </div>

    <dl class="hero-stats">
        <div class="hero-stat reveal">
            <dt>проектов</dt>
            <dd>@Model.Projects.Count</dd>
        </div>
        <div class="hero-stat reveal reveal-d1">
            <dt>технологий</dt>
            <dd>@techCount</dd>
        </div>
        <div class="hero-stat reveal reveal-d2">
            <dt>лет в коде</dt>
            <dd>3+</dd>
        </div>
    </dl>
</section>

@* ==================== О МНЕ ==================== *@
<section id="about" class="about">
    <span class="section-kicker">01 / about</span>
    <h2 class="section-title">Обо мне</h2>

    <div class="about-grid">
        <div class="about-text reveal">
            <p>
                Программирую четвёртый год. С eight класса — академия, Visual Studio 2022,
                C# и C++. Основная работа сейчас — веб на ASP.NET Core и базы данных.
            </p>
            <p>
                Делаю то, что можно показать и потрогать: сайт, программу, отчёт.
                Не исчезаю после сдачи — остаюсь на связи и правлю, пока клиент не доволен.
            </p>
        </div>

        <ul class="about-facts reveal reveal-d1">
            <li><span>Инструмент</span><strong>Visual Studio 2022</strong></li>
            <li><span>Основной язык</span><strong>C#</strong></li>
            <li><span>Платформа</span><strong>.NET 9</strong></li>
            <li><span>База данных</span><strong>SQL Server</strong></li>
            <li><span>Связь</span><strong>GitHub · FL.ru</strong></li>
        </ul>
    </div>
</section>

@* ==================== НАВЫКИ ==================== *@
<section id="skills" class="skills">
    <span class="section-kicker">02 / skills</span>
    <h2 class="section-title">Навыки</h2>

    @foreach (var group in skillGroups)
    {
        <div class="skill-group">
            <h3 class="skill-group-title">@group.Key</h3>

            <div class="skill-list">
                @foreach (var skill in group)
                {
                    <article class="skill-card reveal">
                        <div class="skill-header">
                            <h4>@skill.Name</h4>
                            <span class="skill-percent">@skill.LevelPercent%</span>
                        </div>

                        <div class="skill-progress"
                             role="progressbar"
                             aria-label="@skill.Name"
                             aria-valuemin="0"
                             aria-valuemax="100"
                             aria-valuenow="@skill.LevelPercent">
                            @* --p нужна, чтобы полоска плавно доезжала до нужной ширины *@
                            <div class="skill-progress-bar" style="--p: @(skill.LevelPercent)%"></div>
                        </div>
                    </article>
                }
            </div>
        </div>
    }
</section>

@* ==================== МОИ ПРОЕКТЫ ==================== *@
<section id="projects" class="projects">
    <span class="section-kicker">03 / projects</span>
    <h2 class="section-title">Проекты</h2>

    <div class="project-list">
        @foreach (var project in Model.Projects)
        {
            var tags = techTags(project);
            var firstLetter = string.IsNullOrWhiteSpace(project.Title)
                ? "?"
                : project.Title.Trim().Substring(0, 1);

            <article class="project-card reveal">
                <div class="project-media">
                    @if (!string.IsNullOrWhiteSpace(project.ImageUrl))
                    {
                        <img class="project-image"
                             src="@project.ImageUrl"
                             alt="Скриншот проекта @project.Title"
                             loading="lazy"
                             decoding="async" />
                    }
                    else
                    {
                        @* Картинки нет — показываем заглушку с первой буквой названия. *@
                        <div class="project-placeholder" aria-hidden="true">@firstLetter</div>
                    }
                </div>

                <div class="project-body">
                    <h3 class="project-title">@project.Title</h3>

                    <p class="project-short">@project.ShortDescription</p>

                    @if (!string.IsNullOrWhiteSpace(project.FullDescription))
                    {
                        <p class="project-full">@project.FullDescription</p>
                    }

                    @if (tags.Count > 0)
                    {
                        <ul class="tag-list">
                            @foreach (var tag in tags)
                            {
                                <li class="tag">@tag</li>
                            }
                        </ul>
                    }

                    @* Кнопки показываем только если есть хотя бы одна ссылка. *@
                    @if (!string.IsNullOrWhiteSpace(project.ProjectUrl) ||
                                !string.IsNullOrWhiteSpace(project.GitHubUrl))
                    {
                        <div class="project-buttons">
                            @if (!string.IsNullOrWhiteSpace(project.ProjectUrl))
                            {
                                <a class="main-button"
                                   href="@project.ProjectUrl"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    Открыть сайт
                                </a>
                            }

                            @if (!string.IsNullOrWhiteSpace(project.GitHubUrl))
                            {
                                <a class="main-button secondary-button"
                                   href="@project.GitHubUrl"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    Код на GitHub
                                </a>
                            }
                        </div>
                    }
                </div>
            </article>
        }
    </div>
</section>

@* ==================== УСЛУГИ ==================== *@
<section id="services" class="services">
    <span class="section-kicker">04 / services</span>
    <h2 class="section-title">Чем могу помочь</h2>

    <div class="service-list">
        <article class="service-card reveal">
            <h3>Лендинг под услугу</h3>
            <p>Один экран, который объясняет предложение и собирает заявки в форму. Готово за 3 дня.</p>
        </article>

        <article class="service-card reveal reveal-d1">
            <h3>Сайт под ключ</h3>
            <p>Несколько страниц, форма заявок, база данных и панель, где заявки видны сразу.</p>
        </article>

        <article class="service-card reveal reveal-d2">
            <h3>Доработка сайта</h3>
            <p>Исправлю ошибки, добавлю блок или форму, сделаю адаптацию под телефон.</p>
        </article>

        <article class="service-card reveal reveal-d3">
            <h3>Программа для Windows</h3>
            <p>Учёт заявок, клиентов или товаров под вашу задачу. С входом пользователей и базой.</p>
        </article>
    </div>
</section>

@* ==================== ЦЕНЫ ==================== *@
<section id="prices" class="prices">
    <span class="section-kicker">05 / prices</span>
    <h2 class="section-title">Сколько стоит</h2>

    <p class="section-lead">
        Цены фиксированные: сумма называется до начала работы и не меняется по ходу.
        Всё, что ниже, — с разработкой, текстами и запуском.
    </p>

    <div class="price-grid">
        <article class="price-card reveal">
            <h3 class="price-name">Визитка</h3>
            <p class="price-note">Одна страница для услуги или небольшого дела</p>
            <p class="price-value">15 000 ₽</p>
            <p class="price-term">5–7 дней</p>

            <ul class="price-list">
                <li>Одна страница: услуги, цены, контакты</li>
                <li>Карта и кнопка мессенджера</li>
                <li>Заявки приходят на почту и в мессенджер</li>
                <li>Хорошо открывается с телефона</li>
                <li>Домен и хостинг оформляю на вас</li>
            </ul>

            <a class="main-button secondary-button" href="#contact">Обсудить</a>
        </article>

        <article class="price-card featured reveal reveal-d1">
            <span class="price-badge">чаще всего</span>
            <h3 class="price-name">Сайт с каталогом</h3>
            <p class="price-note">Когда товаров или услуг много</p>
            <p class="price-value">30 000 ₽</p>
            <p class="price-term">10–14 дней</p>

            <ul class="price-list">
                <li>До 5 страниц: главная, каталог, о компании</li>
                <li>Карточки товаров или услуг с фото и ценами</li>
                <li>Поиск и фильтры по разделам</li>
                <li>Форма заявки и уведомления в мессенджер</li>
                <li>Простая панель, где видно заявки</li>
            </ul>

            <a class="main-button" href="#contact">Обсудить</a>
        </article>

        <article class="price-card reveal reveal-d2">
            <h3 class="price-name">Поддержка</h3>
            <p class="price-note">Для сайтов, которые уже работают</p>
            <p class="price-value">3 000 ₽</p>
            <p class="price-term">в месяц</p>

            <ul class="price-list">
                <li>Слежу, что сайт открывается</li>
                <li>Правки текстов и цен</li>
                <li>Добавление новых блоков</li>
                <li>Помощь с доменом и почтой</li>
                <li>Отвечаю в тот же день</li>
            </ul>

            <a class="main-button secondary-button" href="#contact">Обсудить</a>
        </article>
    </div>

    @* Гарантия заменяет отзывы, пока их нет. *@
    <div class="guarantee">
        <div class="guarantee-item reveal">
            <strong>Месяц правок бесплатно</strong>
            <p>После сдачи месяц правлю тексты, цены и мелочи без доплаты.</p>
        </div>

        <div class="guarantee-item reveal reveal-d1">
            <strong>Не понравится — верну деньги</strong>
            <p>Если результат не тот, о чём договаривались, — возвращаю оплату.</p>
        </div>

        <div class="guarantee-item reveal reveal-d2">
            <strong>Сайт остаётся вам</strong>
            <p>Отдаю все файлы и доступы. Никакой привязки ко мне нет.</p>
        </div>
    </div>
</section>

@* ==================== ДЕМО-САЙТЫ ==================== *@
<section id="demos" class="demos">
    <span class="section-kicker">06 / demos</span>
    <h2 class="section-title">Примеры по отраслям</h2>

    <p class="section-lead">
        Это демонстрационные сайты, сделанные как образец. Не заказы клиентов —
        показываю, как будет выглядеть страница для вашей сферы.
    </p>

    <div class="demo-grid">
        <a class="demo-card reveal" asp-page="/Demo/Autoservice">
            <div class="demo-preview auto"><span>автосервис</span></div>
            <div class="demo-body">
                <h3>Автосервис и шиномонтаж</h3>
                <p>Услуги, цены, запись, карта и телефон в один экран.</p>
            </div>
        </a>

        <a class="demo-card reveal reveal-d1" asp-page="/Demo/Him">
            <div class="demo-preview him"><span>химия</span></div>
            <div class="demo-body">
                <h3>Поставщик химии</h3>
                <p>Каталог продукции, условия поставки, заявка на прайс.</p>
            </div>
        </a>

        <a class="demo-card reveal reveal-d2" asp-page="/Demo/Agro">
            <div class="demo-preview agro"><span>сельхозтехника</span></div>
            <div class="demo-body">
                <h3>Сельхозтехника</h3>
                <p>Техника и запчасти, подбор по задаче, заявка на консультацию.</p>
            </div>
        </a>
    </div>
</section>

@* ==================== КВИЗ ==================== *@
<section id="quiz" class="quiz-section">
    <span class="section-kicker">07 / calculator</span>
    <h2 class="section-title">Сколько будет стоить</h2>

    <p class="section-lead">
        Три вопроса — и видно цену без переписки.
    </p>

    <div class="quiz reveal" id="priceQuiz">
        <div class="quiz-step">
            <p class="quiz-question">1. Что нужно?</p>
            <div class="quiz-options" data-question="kind">
                <button type="button" class="quiz-option" data-price="15000">Одна страница</button>
                <button type="button" class="quiz-option" data-price="30000">Сайт с каталогом</button>
                <button type="button" class="quiz-option" data-price="5000">Доработать текущий</button>
            </div>
        </div>

        <div class="quiz-step">
            <p class="quiz-question">2. Нужны тексты и фото?</p>
            <div class="quiz-options" data-question="content">
                <button type="button" class="quiz-option" data-price="0">Всё есть</button>
                <button type="button" class="quiz-option" data-price="3000">Помочь с текстами</button>
            </div>
        </div>

        <div class="quiz-step">
            <p class="quiz-question">3. Как срочно?</p>
            <div class="quiz-options" data-question="speed">
                <button type="button" class="quiz-option" data-price="0">Спокойно, 2 недели</button>
                <button type="button" class="quiz-option" data-price="4000">Нужно за 5 дней</button>
            </div>
        </div>

        <div class="quiz-result" id="quizResult" hidden>
            <p>Примерная стоимость:</p>
            <p class="quiz-price" id="quizPrice">0 ₽</p>
            <p id="quizHint">Точную цену скажу после короткого разговора — она может быть ниже.</p>

            <div class="quiz-actions">
                <a class="main-button" href="#contact">Отправить заявку</a>
                <a class="main-button secondary-button"
                   href="@quizTgUrl"
                   target="_blank"
                   rel="noopener noreferrer">Написать в Telegram</a>
            </div>
        </div>
    </div>
</section>

@* ==================== КАК Я РАБОТАЮ ==================== *@
<section id="process" class="process">
    <span class="section-kicker">08 / process</span>
    <h2 class="section-title">Как я работаю</h2>

    <div class="process-list">
        <article class="process-card reveal">
            <span class="process-num">01</span>
            <h3>Обсуждаем задачу</h3>
            <p>
                Вы описываете, что нужно сделать. Я задаю уточняющие вопросы и говорю
                честно, сколько это стоит и сколько займёт. Если задача решается проще
                или дешевле — скажу сразу, а не возьму лишние деньги.
            </p>
        </article>

        <article class="process-card reveal reveal-d1">
            <span class="process-num">02</span>
            <h3>Фиксируем объём и цену</h3>
            <p>
                Согласуем, что именно входит в работу: страницы, функции, тексты, сроки.
                Цена не меняется в процессе. Если вы просите добавить то, о чём не договаривались,
                я скажу цену до начала, а не после.
            </p>
        </article>

        <article class="process-card reveal reveal-d2">
            <span class="process-num">03</span>
            <h3>Делаю и показываю</h3>
            <p>
                Работаю по этапам и показываю промежуточный результат. Вы видите,
                как идёт дело, и можете попросить изменить раньше, чем всё будет готово.
            </p>
        </article>

        <article class="process-card reveal reveal-d3">
            <span class="process-num">04</span>
            <h3>Сдаю и правлю</h3>
            <p>
                Запускаю на хостинге или передаю файлы, показываю как пользоваться.
                Две недели после сдачи правлю бесплатно. Дальше — по договорённости.
            </p>
        </article>
    </div>

    <div class="process-terms reveal">
        <div class="process-term">
            <p class="process-term-title">оплата</p>
            <p>Предоплата 50%, остальное после сдачи. Или безопасная сделка через фриланс-биржу.</p>
        </div>

        <div class="process-term">
            <p class="process-term-title">сроки</p>
            <p>Лендинг — 3 дня. Сайт до 5 страниц — 10–14 дней. Программа с базой — от 3 недель.</p>
        </div>

        <div class="process-term">
            <p class="process-term-title">правки</p>
            <p>Две недели после сдачи — бесплатно. Дальше по договорённости, без сюрпризов в сумме.</p>
        </div>

        <div class="process-term">
            <p class="process-term-title">останется у вас</p>
            <p>Все файлы и доступы. Сайт ваш, никакой привязки ко мне нет.</p>
        </div>
    </div>
</section>

@* ==================== КОНТАКТЫ И ФОРМА ЗАЯВКИ ==================== *@
<section id="contact" class="contact">
    <span class="section-kicker">09 / contact</span>
    <h2 class="section-title">Написать мне</h2>

    <p class="contact-lead">
        Расскажите задачу — отвечу в течение дня и скажу честно,
        сколько это будет стоить и сколько займёт.
    </p>

    @if (Model.IsRequestSent)
    {
        <p class="success-message">Заявка отправлена. Я свяжусь с вами.</p>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="error-summary">
            Проверьте заполнение формы.
        </div>
    }

    <div class="contact-grid">
        <form method="post" class="request-form reveal" novalidate>
            <div class="form-field">
                <label asp-for="ClientForm.ClientName">Ваше имя</label>
                <input asp-for="ClientForm.ClientName" placeholder="Иван" maxlength="300" />
                <span asp-validation-for="ClientForm.ClientName" class="field-error"></span>
            </div>

            <div class="form-field">
                <label asp-for="ClientForm.ClientEmail">Email</label>
                <input asp-for="ClientForm.ClientEmail" type="email" placeholder="ivan@example.com" maxlength="510" />
                <span asp-validation-for="ClientForm.ClientEmail" class="field-error"></span>
            </div>

            <div class="form-field">
                <label asp-for="ClientForm.ClientPhone">Телефон <span class="optional">(необязательно)</span></label>
                <input asp-for="ClientForm.ClientPhone" type="tel" placeholder="+7 900 000-00-00" maxlength="100" />
                <span asp-validation-for="ClientForm.ClientPhone" class="field-error"></span>
            </div>

            <div class="form-field">
                <label asp-for="ClientForm.ClientMessage">Что нужно сделать</label>
                <textarea asp-for="ClientForm.ClientMessage" rows="5" placeholder="Коротко о задаче" maxlength="4000"></textarea>
                <span asp-validation-for="ClientForm.ClientMessage" class="field-error"></span>
            </div>

            @* Метка времени: по ней видно, что форму не отправили сразу. *@
            <input type="hidden" asp-for="ClientForm.FormStamp" />

            @* Honeypot: скрыто от людей, но заполняется ботами. Не удалять. *@
            <div class="hp" aria-hidden="true">
                <label>Не заполняйте это поле</label>
                <input asp-for="ClientForm.Website" tabindex="-1" autocomplete="off" />
            </div>

            <button class="main-button" type="submit">Отправить заявку</button>
        </form>

        <aside class="contact-side reveal reveal-d1">
            <p class="contact-side-title">написать в мессенджер</p>

            @* Многим проще написать, чем заполнять форму. *@
            <div class="messenger-row">
                <a class="messenger-button telegram"
                   href="@contactTgUrl"
                   target="_blank"
                   rel="noopener noreferrer">
                    <span class="dot" aria-hidden="true"></span>
                    <span>
                        Telegram
                        <small>@@@SiteInfo.Telegram</small>
                    </span>
                </a>
            </div>

            <p class="contact-side-title">связаться</p>

            <a class="contact-link" href="https://github.com/bxlia" target="_blank" rel="noopener noreferrer">
                github.com/bxlia
            </a>
            <a class="contact-link" href="https://www.fl.ru/users/bxlia82/portfolio/" target="_blank" rel="noopener noreferrer">
                профиль на fl.ru
            </a>

            @* Способы оплаты: напрямую или через биржу. Снимает главный страх клиента. *@
            <div class="pay-box">
                <p class="pay-box-title">как оплатить</p>

                <p class="pay-box-item">
                    <strong>Через фриланс-биржу</strong>
                    Деньги переводятся мне только после того, как вы приняли работу.
                    Если что-то не понравилось — напишите, поправлю до сдачи.
                    Заказ оформляем на <a href="https://www.fl.ru/users/bxlia82/" target="_blank" rel="noopener noreferrer">fl.ru</a>.
                </p>

                <p class="pay-box-item">
                    <strong>Напрямую</strong>
                    Предоплата 50%, остальное после сдачи. Две недели правок бесплатно.
                    Если незнакомы — лучше выбрать вариант через биржу.
                </p>
            </div>
