@page
@{
    ViewData["Title"] = "Сайт для поставщика химии и реагентов: что должно быть | bulia";
    ViewData["Description"] = "Как устроен сайт B2B-поставщика химии: каталог по отраслям, документы, условия поставки, заявка на прайс. Цена, сроки и ошибки, теряющие клиентов.";
    ViewData["CanonicalPath"] = "/SaitDlyaHimii";

    var faq = new[]
    {
        ("Чем сайт поставщика химии отличается от обычной визитки?", "Тем, что клиент — технолог или снабженец, и ему нужны не красивые слова, а марка, фасовка, документы и срок поставки. Поэтому каталог строится по отраслям и по назначению продукта, а не по алфавиту."),
        ("Сколько стоит такой сайт?", "Одностраничный сайт с каталогом, условиями поставки и заявкой на прайс — 15 000 ₽. Каталог с отдельной страницей под каждую группу товаров — от 30 000 ₽. Цена фиксируется до старта."),
        ("Сколько времени занимает?", "Визитка — 5–7 рабочих дней. Каталог с категориями — 10–14 дней, если есть готовый список товаров и документы."),
        ("Нужен ли интернет-магазин с оплатой?", "Обязательно нет. В B2B цена зависит от объёма и условий, поэтому вместо корзины работает заявка на прайс и расчёт по запросу. Магазин имеет смысл, если продаёте мелким оптом в розницу."),
        ("Кто пишет тексты про продукцию?", "Я пишу структуру и описания на основе ваших данных: назначение, фасовка, аналог, условия хранения. Технические характеристики присылаете вы — за них отвечает поставщик, а не копирайтер.")
    };
}

@section Head {
    @{
        var faqData = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "FAQPage",
            ["mainEntity"] = faq.Select(item => new Dictionary<string, object>
            {
                ["@type"] = "Question",
                ["name"] = item.Item1,
                ["acceptedAnswer"] = new Dictionary<string, object>
                {
                    ["@type"] = "Answer",
                    ["text"] = item.Item2
                }
            }).ToArray()
        };
        var faqJson = System.Text.Json.JsonSerializer.Serialize(faqData, new System.Text.Json.JsonSerializerOptions
        {
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        });
    }
    @Html.Raw("<script type=\"application/ld+json\">" + faqJson + "</script>")
}

<article class="case-page">
    <span class="section-kicker">поставщикам химии</span>
    <h1>Сайт для поставщика химии: каталог, документы и заявка на прайс</h1>

    <p class="case-lead">
        В B2B-поставках сайт редко продаёт сразу. Его задача — попасть в поиск,
        показать, что вы работаете с нужным веществом, и дать возможность
        запросить цену без десяти писем. Ниже — что для этого нужно на странице.
    </p>

    <div class="case-day">
        <span class="case-day-num">блок 1</span>
        <div>
            <h2>Первый экран: что поставляете и кому</h2>
            <p>
                Снабженец ищет конкретику: «поставка каустической соды», «реагенты для
                водоподготовки». Если на первом экране написано «комплексные решения
                для бизнеса», человек уходит к конкуренту.
            </p>
            <ul>
                <li>название отрасли и тип продукции;</li>
                <li>условия: опт, фасовка, доставка по России;</li>
                <li>кнопка «Запросить прайс».</li>
            </ul>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">блок 2</span>
        <div>
            <h2>Каталог по отраслям, а не по алфавиту</h2>
            <p>
                Клиент не знает маркировку — он знает, для чего вещество нужно.
                Поэтому каталог собирается по задачам: водоочистка, пищевое
                производство, металлообработка, сельское хозяйство.
            </p>
            <ul>
                <li>группы по назначению, внутри — конкретные позиции;</li>
                <li>у каждой позиции: фасовка, аналог, условия хранения;</li>
                <li>поиск по названию и синонимам — люди пишут «сода каустическая» и «гидроксид натрия».</li>
            </ul>
            <p>
                Если позиций больше сотни — делаю отдельные страницы под группы.
                Тогда по каждой группе можно попасть в поиск, а не бороться
                за одну общую страницу.
            </p>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">блок 3</span>
        <div>
            <h2>Документы и доверие</h2>
            <p>
                Химию не покупают у неизвестного продавца: нужны паспорта качества,
                сертификаты, гарантия происхождения. Это не «приятное дополнение»,
                а условие сделки.
            </p>
            <ul>
                <li>сертификаты и паспорта качества — PDF, по позициям;</li>
                <li>условия хранения и сроки годности;</li>
                <li>реквизиты, ИНН, опыт работы — открыто, без «уточняйте у менеджера».</li>
            </ul>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">блок 4</span>
        <div>
            <h2>Вместо корзины — заявка на прайс</h2>
            <p>
                В B2B цена зависит от объёма, региона и условий оплаты. Поэтому
                корзина с фиксированной ценой только мешает: клиенту всё равно
                нужно согласование.
            </p>
            <ul>
                <li>форма: организация, объём, что нужно, контакт;</li>
                <li>заявка приходит сразу в мессенджер или на почту отдела продаж;</li>
                <li>рядом — телефон и почта, если удобнее позвонить.</li>
            </ul>
            <p>
                Работает простая вещь: чем меньше полей, тем больше заявок.
                Объём и название продукта важнее, чем «должность» и «как вы о нас узнали».
            </p>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">блок 5</span>
        <div>
            <h2>Условия поставки без сюрпризов</h2>
            <p>
                Снабженец сравнивает не только цену, но и срок. Если этого нет на сайте,
                он пишет в почту и ждёт ответа — а пока ждёт, спрашивает у других.
            </p>
            <ul>
                <li>минимальная партия и кратность;</li>
                <li>сроки отгрузки и регионы доставки;</li>
                <li>оплата: по счёту, с отсрочкой, самовывоз.</li>
            </ul>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">цена</span>
        <div>
            <h2>Сколько стоит и сколько ждать</h2>
            <ul>
                <li><strong>визитка</strong> с каталогом и заявкой — 15 000 ₽, 5–7 рабочих дней;</li>
                <li><strong>каталог</strong> с отдельными страницами групп — от 30 000 ₽, 10–14 дней;</li>
                <li><strong>поддержка</strong> — 3 000 ₽ в месяц, по желанию.</li>
            </ul>
            <p>
                Сайт на чистом коде, без конструктора и ежемесячной подписки.
                Доступы и файлы остаются у вас.
            </p>
        </div>
    </div>

    <div class="case-day">
        <span class="case-day-num">вопросы</span>
        <div>
            <h2>Частые вопросы</h2>
            @foreach (var item in faq)
            {
                <h2 style="font-size:1.05rem;margin-bottom:.35rem">@item.Item1</h2>
                <p>@item.Item2</p>
            }
        </div>
    </div>

    <div class="case-total">
        <p>
            <strong>Пример структуры:</strong> демонстрационный сайт поставщика промышленной химии.
            Компания вымышленная, это не заказ клиента.
        </p>
        <p style="margin-bottom:0">
            <a class="main-button" href="/#contact">Обсудить сайт</a>
            <a class="main-button secondary-button" asp-page="/Demo/Him" style="margin-left:10px">Открыть пример</a>
        </p>
        <p style="margin-top:1rem">
            Другие отрасли: <a asp-page="/SaitDlyaAvtoservisa">сайт для автосервиса</a>,
            <a asp-page="/SaitDlyaSelhoztehniki">сайт для магазина сельхозтехники</a>.
        </p>
    </div>
</article>
